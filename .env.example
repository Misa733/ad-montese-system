# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo.

# Supabase (Project Settings > API). A chave anon e publica; quem protege os dados e o RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Somente no servidor (Vercel). Nao use prefixo VITE_ aqui, senao a chave vai para o navegador.
# Opcao recomendada: conta de servico do Google com acesso de leitura a planilha.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Alternativa mais simples (exige a planilha aberta por link):
GOOGLE_SHEETS_API_KEY=
